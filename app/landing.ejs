<div id="landingContainer" style="display: none;">

    <!-- Barra lateral -->
    <nav id="barraLateral" aria-label="<%- lang('inicio.navegacion') %>">
        <div id="image_seal_container" class="marca" title="<%- lang('landing.updateAvailableTooltip') %>">
            <svg class="marcaEmblema" viewBox="0 0 400 480" aria-hidden="true">
                <path d="M205 30 C 290 30 345 95 352 180 C 356 225 368 250 368 300 C 370 400 300 458 205 458 C 105 458 32 405 34 318 C 36 250 52 205 58 170 C 72 85 125 30 205 30 Z" fill="#F3F1E7" stroke="#F3F1E7" stroke-width="16" stroke-linejoin="round"/>
                <path d="M30 170 L368 150 L372 182 L34 200 Z" fill="#111" stroke="#111" stroke-width="10" stroke-linejoin="round"/>
                <path d="M62 180 L192 174 C 190 232 162 262 122 260 C 86 258 66 226 62 180 Z" fill="#111"/>
                <path d="M210 172 L352 166 C 350 226 318 258 274 256 C 232 254 212 226 210 172 Z" fill="#111"/>
                <path d="M150 312 C 200 312 245 300 272 280 C 270 316 244 340 214 338 C 190 336 174 326 166 313 Z" fill="#111"/>
            </svg>
            <div class="marcaTexto">
                <span class="marcaNombre"><%- lang('inicio.marcaNombre') %></span>
                <span class="marcaLauncher"><%- lang('inicio.marcaLauncher') %></span>
            </div>
            <span id="avisoActualizacion"></span>
        </div>

        <div class="navGrupo">
            <button class="navBoton" data-seccion="inicio" aria-current="page">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
                <%- lang('inicio.navInicio') %>
            </button>
            <button class="navBoton" data-seccion="servidores">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="1"/><rect x="3" y="13" width="18" height="7" rx="1"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>
                <%- lang('inicio.navServidores') %>
            </button>
            <button class="navBoton" data-seccion="instancias">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
                <%- lang('inicio.navInstancias') %>
            </button>
        </div>

        <div class="navRelleno"></div>

        <div id="mojangServicios">
            <span class="etiquetaChica"><%- lang('inicio.mojangTitulo') %></span>
            <div id="mojangLista">
                <span class="mojangItem" data-grupo="login"><span class="punto"></span><%- lang('inicio.mojangLogin') %></span>
                <span class="mojangItem" data-grupo="sesiones"><span class="punto"></span><%- lang('inicio.mojangSesiones') %></span>
                <span class="mojangItem" data-grupo="skins"><span class="punto"></span><%- lang('inicio.mojangSkins') %></span>
            </div>
            <a id="linkURL" class="mediaURL enlaceRepo" href="<%- lang('landing.mediaGitHubURL') %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5M15 22v-3.5a3 3 0 00-.9-2.4c3-.3 6-1.5 6-6.6a5 5 0 00-1.4-3.6 4.7 4.7 0 00-.1-3.6s-1.1-.3-3.6 1.4a12.4 12.4 0 00-6.6 0C5.9 2 4.8 2.3 4.8 2.3a4.7 4.7 0 00-.1 3.6A5 5 0 003.3 9.5c0 5.1 3 6.3 6 6.6a3 3 0 00-.9 2.4V22"/></svg>
                <%- lang('inicio.repositorio') %>
            </a>
        </div>

        <button class="navBoton" id="settingsMediaButton">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z"/></svg>
            <%- lang('inicio.ajustes') %>
        </button>

        <button id="cuentaTarjeta" data-seccion="perfil">
            <img id="cuentaCabeza" alt="" src="assets/images/potato/icono-64.png">
            <span class="cuentaTextos">
                <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                <span class="cuentaTipo"><%- lang('inicio.cuentaMicrosoft') %></span>
            </span>
        </button>
    </nav>

    <!-- Contenido -->
    <main id="contenido">

        <!-- Inicio -->
        <section class="seccion" id="seccionInicio" data-seccion="inicio">
            <header class="saludo">
                <div>
                    <h1 id="saludoTitulo" class="tituloPixel"></h1>
                    <p class="textoSuave"><%- lang('inicio.saludoSub') %></p>
                </div>
                <button class="botonPunteado" data-accion="crear">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    <%- lang('inicio.crearInstancia') %>
                </button>
            </header>

            <section id="continuar" class="bannerContinuar" aria-label="<%- lang('inicio.continuar') %>" style="display: none;">
                <div class="bannerArte"></div>
                <div class="bannerPie">
                    <div class="bannerInfo">
                        <span class="etiquetaPixel"><%- lang('inicio.continuar') %></span>
                        <h2 class="bannerNombre tituloPixel"></h2>
                        <div class="bannerChips"></div>
                    </div>
                    <div class="bannerAcciones">
                        <button class="botonSecundario" data-accion="ver"></button>
                        <button class="botonJugar" data-accion="jugar"><%- lang('landing.launchButton') %></button>
                    </div>
                </div>
            </section>

            <section class="bloque" id="bloqueNoticias" style="display: none;">
                <div class="bloqueCabeza">
                    <h3 class="tituloPixel"><%- lang('inicio.noticias') %></h3>
                </div>
                <div class="grillaNoticias" id="listaNoticias"></div>
            </section>

            <section class="bloque">
                <div class="bloqueCabeza">
                    <h3 class="tituloPixel"><%- lang('inicio.servidores') %></h3>
                    <span class="textoSuave"><%- lang('inicio.servidoresSub') %></span>
                </div>
                <div class="grillaTarjetas" id="inicioServidores"></div>
            </section>

            <section class="bloque">
                <div class="bloqueCabeza">
                    <h3 class="tituloPixel"><%- lang('inicio.instancias') %></h3>
                    <span class="textoSuave"><%- lang('inicio.instanciasSub') %></span>
                </div>
                <div class="grillaTarjetas" id="inicioInstancias"></div>
            </section>
        </section>

        <!-- Servidores -->
        <section class="seccion" id="seccionServidores" data-seccion="servidores" hidden>
            <header class="saludo">
                <div>
                    <h1 class="tituloPixel"><%- lang('inicio.servidores') %></h1>
                    <p class="textoSuave"><%- lang('inicio.servidoresSub') %></p>
                </div>
            </header>
            <div class="grillaTarjetas" id="listaServidores"></div>
        </section>

        <!-- Mis instancias -->
        <section class="seccion" id="seccionInstancias" data-seccion="instancias" hidden>
            <header class="saludo">
                <div>
                    <h1 class="tituloPixel"><%- lang('inicio.instancias') %></h1>
                    <p class="textoSuave"><%- lang('inicio.instanciasSub') %></p>
                </div>
                <button class="botonPunteado" data-accion="crear">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    <%- lang('inicio.crearInstancia') %>
                </button>
            </header>
            <div class="grillaTarjetas" id="listaInstancias"></div>
        </section>

        <!-- Vista de un servidor: plantilla con paneles (servidores-extra.json → paneles). -->
        <section class="seccion" id="seccionServidor" data-seccion="servidor" hidden>
            <div class="servidorHeroe">
                <div id="fondoReino" class="servidorArte"></div>
                <canvas id="ambienteBrasas"></canvas>
                <div id="lunaVelo"></div>
                <button class="botonVolver" data-volver aria-label="<%- lang('inicio.volver') %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <!-- Panel "tierras" (reino.js): Prueba, voz de Aldric y rótulo de la luna. -->
                <div id="reinoEscena">
                    <div id="pruebaBarra" style="display: none;">
                        <div id="pruebaTexto"></div>
                        <div id="pruebaRiel"><div id="pruebaLleno"></div></div>
                    </div>
                    <div id="aldricVoz" style="display: none;">
                        <div id="aldricFrase"></div>
                        <div id="aldricFirma"><%- lang('landing.aldricFirma') %></div>
                    </div>
                    <div id="lunaRotulo"><%- lang('landing.lunaRotulo') %></div>
                </div>
                <div class="servidorPie">
                    <div class="servidorIdentidad">
                        <div id="servidorIconoMarco">
                            <img id="servidorIcono" alt="">
                            <div id="coronaGemas"></div>
                        </div>
                        <div class="servidorTextos">
                            <h1 id="servidorNombre" class="tituloPixel"></h1>
                            <div id="servidorChips" class="bannerChips"></div>
                        </div>
                    </div>
                    <div class="servidorAcciones">
                        <div id="conectadosCabezas"></div>
                        <button id="launch_button" class="botonJugar" data-brasas data-accion="jugar"><%- lang('landing.launchButton') %></button>
                    </div>
                </div>
            </div>
            <div class="pestanas" role="tablist" data-grupo="servidor">
                <button role="tab" data-pestana="resumen" aria-selected="true"><%- lang('inicio.pestResumen') %></button>
                <button role="tab" data-pestana="mods" aria-selected="false"><%- lang('inicio.pestMods') %></button>
                <button role="tab" data-pestana="carpetas" aria-selected="false"><%- lang('inicio.pestCarpetas') %></button>
            </div>
            <div class="servidorCuerpo">
                <div class="pestana" data-grupo="servidor" data-pestana="resumen">
                    <p id="servidorDescripcion" class="textoSuave"></p>
                    <div id="panelesServidor" class="grillaPaneles"></div>
                    <!-- Crónicas del panel "tierras"; inicio.js lo mueve dentro de su panel. -->
                    <div id="cronicasPanel">
                        <h3 id="cronicasTitulo" class="tituloPixel"><%- lang('landing.cronicasTitle') %></h3>
                        <div id="cronicasLista"></div>
                    </div>
                </div>
                <div class="pestana" data-grupo="servidor" data-pestana="mods" hidden>
                    <p class="textoSuave"><%- lang('inicio.modsServidorNota') %></p>
                    <div id="servidorMods" class="listaMods"></div>
                </div>
                <div class="pestana" data-grupo="servidor" data-pestana="carpetas" hidden>
                    <p class="textoSuave"><%- lang('inicio.carpetasServidorNota') %></p>
                    <div id="servidorCarpetas" class="grillaCarpetas"></div>
                </div>
            </div>
        </section>

        <!-- Vista de una instancia propia -->
        <section class="seccion" id="seccionInstancia" data-seccion="instancia" hidden>
            <div class="instanciaCabeza">
                <button class="botonVolver plano" data-volver aria-label="<%- lang('inicio.volver') %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <span id="instanciaIcono" class="iconoLoader grande"></span>
                <div class="instanciaTextos">
                    <h1 id="instanciaNombre" class="tituloPixel"></h1>
                    <span id="instanciaVersion" class="textoSuave"></span>
                </div>
                <button class="botonJugar" data-accion="jugar"><%- lang('landing.launchButton') %></button>
            </div>
            <div class="pestanas" role="tablist" data-grupo="instancia">
                <button role="tab" data-pestana="general" aria-selected="true"><%- lang('inicio.pestGeneral') %></button>
                <button role="tab" data-pestana="mods" aria-selected="false" id="pestanaModsInstancia"><%- lang('inicio.pestMods') %></button>
                <button role="tab" data-pestana="carpetas" aria-selected="false"><%- lang('inicio.pestCarpetas') %></button>
                <button role="tab" data-pestana="rendimiento" aria-selected="false"><%- lang('inicio.pestRendimiento') %></button>
            </div>

            <div class="pestana" data-grupo="instancia" data-pestana="general">
                <form class="panel formInstancia" id="formEditar" autocomplete="off">
                    <label class="campo">
                        <span><%- lang('inicio.crearNombre') %></span>
                        <input type="text" id="editNombre" maxlength="40" required>
                    </label>
                    <div class="campo">
                        <span><%- lang('inicio.editIcono') %></span>
                        <div class="filaIcono">
                            <span id="editIconoVista" class="iconoLoader grande"></span>
                            <button type="button" class="botonSecundario" data-accion="iconoElegir"><%- lang('inicio.editIconoElegir') %></button>
                            <button type="button" class="botonSecundario" data-accion="iconoQuitar"><%- lang('inicio.editIconoQuitar') %></button>
                        </div>
                    </div>
                    <fieldset class="campo">
                        <legend><%- lang('inicio.crearLoader') %></legend>
                        <div id="editLoaders" class="opcionesLoader"></div>
                    </fieldset>
                    <div class="filaCampos">
                        <label class="campo">
                            <span><%- lang('inicio.crearVersion') %></span>
                            <select id="editVersion" required></select>
                        </label>
                        <label class="campo" id="editLoaderVersionCampo">
                            <span><%- lang('inicio.crearLoaderVersion') %></span>
                            <select id="editLoaderVersion"></select>
                        </label>
                    </div>
                    <label class="casilla">
                        <input type="checkbox" id="editSnapshots">
                        <span><%- lang('inicio.crearSnapshots') %></span>
                    </label>
                    <p class="avisoVersion"><%- lang('inicio.editAvisoVersion') %></p>
                    <p id="editError" class="textoError" hidden></p>
                    <div class="modalAcciones">
                        <span id="editGuardado" class="textoSuave" hidden><%- lang('inicio.editGuardado') %></span>
                        <button type="submit" class="botonPrincipal"><%- lang('inicio.editGuardar') %></button>
                    </div>
                </form>
            </div>

            <div class="pestana" data-grupo="instancia" data-pestana="mods" hidden>
                <div class="barraMods">
                    <button class="botonSecundario" data-accion="modsCarpeta"><%- lang('inicio.modsAbrirCarpeta') %></button>
                    <button class="botonSecundario" data-accion="modsAgregar"><%- lang('inicio.modsAgregar') %></button>
                    <span class="textoSuave" id="modsResumen"></span>
                </div>
                <div id="zonaSoltar" class="zonaSoltar">
                    <span><%- lang('inicio.modsSoltar') %></span>
                </div>
                <div id="instanciaMods" class="listaMods"></div>
            </div>

            <div class="pestana" data-grupo="instancia" data-pestana="carpetas" hidden>
                <div id="instanciaCarpetas" class="grillaCarpetas"></div>
            </div>

            <div class="pestana" data-grupo="instancia" data-pestana="rendimiento" hidden>
                <div class="panelesInstancia">
                    <section class="panel">
                        <h3><%- lang('inicio.instMemoriaTitulo') %></h3>
                        <label class="filaRango">
                            <input type="range" id="instanciaRam" min="1" max="16" step="0.5">
                            <span id="instanciaRamValor"></span>
                        </label>
                        <p class="textoSuave" id="instanciaRamTotal"></p>
                    </section>
                    <section class="panel">
                        <h3><%- lang('inicio.instJavaTitulo') %></h3>
                        <p class="textoSuave" id="instanciaJava"></p>
                        <div class="filaBotones">
                            <button class="botonSecundario" data-accion="java"><%- lang('inicio.instElegirJava') %></button>
                            <button class="botonSecundario" data-accion="javaAuto"><%- lang('inicio.instJavaAuto') %></button>
                        </div>
                    </section>
                    <section class="panel anchoCompleto">
                        <h3><%- lang('inicio.instJvmTitulo') %></h3>
                        <p class="textoSuave"><%- lang('inicio.instJvmTexto') %></p>
                        <textarea id="instanciaJvm" rows="3" spellcheck="false"></textarea>
                        <div class="filaBotones">
                            <button class="botonSecundario" data-accion="jvmGuardar"><%- lang('inicio.editGuardar') %></button>
                            <button class="botonSecundario" data-accion="jvmDefecto"><%- lang('inicio.instJvmDefecto') %></button>
                            <span id="jvmGuardado" class="textoSuave" hidden><%- lang('inicio.editGuardado') %></span>
                        </div>
                    </section>
                </div>
            </div>

            <div class="instanciaPie">
                <button class="botonSecundario" data-accion="duplicar"><%- lang('inicio.instDuplicar') %></button>
                <button class="botonPeligro" data-accion="borrar"><%- lang('inicio.instBorrar') %></button>
            </div>
        </section>

        <!-- Perfil -->
        <section class="seccion" id="seccionPerfil" data-seccion="perfil" hidden>
            <div class="perfilEscena">
                <canvas id="perfilSkin"></canvas>
                <div class="perfilInfo">
                    <span class="etiquetaPixel"><%- lang('inicio.perfilEtiqueta') %></span>
                    <h1 id="perfilNombre" class="tituloPixel"></h1>
                    <p class="textoSuave" id="perfilUuid"></p>
                    <div class="filaBotones">
                        <button class="botonPrincipal" data-accion="skin"><%- lang('inicio.perfilSkin') %></button>
                        <button class="botonSecundario" data-accion="cuentas"><%- lang('inicio.perfilCuentas') %></button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Progreso de descarga y lanzamiento -->
    <div id="launch_details" aria-live="polite">
        <img class="lanzamientoMascota" src="assets/images/potato/mascota-cargando.png" alt="">
        <div id="launch_details_right">
            <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
            <div class="lanzamientoBarra">
                <progress id="launch_progress" value="0" max="100"></progress>
                <span id="launch_progress_label">0%</span>
            </div>
        </div>
    </div>
    <div id="launch_content" hidden></div>

    <!-- Crear instancia -->
    <div id="modalCrear" class="modalFondo" hidden>
        <form class="modal" id="formCrear" autocomplete="off">
            <h2 class="tituloPixel"><%- lang('inicio.crearTitulo') %></h2>
            <label class="campo">
                <span><%- lang('inicio.crearNombre') %></span>
                <input type="text" id="crearNombre" maxlength="40" required placeholder="<%- lang('inicio.crearNombrePlaceholder') %>">
            </label>
            <fieldset class="campo">
                <legend><%- lang('inicio.crearLoader') %></legend>
                <div id="crearLoaders" class="opcionesLoader"></div>
            </fieldset>
            <div class="filaCampos">
                <label class="campo">
                    <span><%- lang('inicio.crearVersion') %></span>
                    <select id="crearVersion" required></select>
                </label>
                <label class="campo" id="crearLoaderVersionCampo">
                    <span><%- lang('inicio.crearLoaderVersion') %></span>
                    <select id="crearLoaderVersion"></select>
                </label>
            </div>
            <label class="casilla">
                <input type="checkbox" id="crearSnapshots">
                <span><%- lang('inicio.crearSnapshots') %></span>
            </label>
            <p id="crearError" class="textoError" hidden></p>
            <div class="modalAcciones">
                <button type="button" class="botonSecundario" data-accion="cancelar"><%- lang('inicio.cancelar') %></button>
                <button type="submit" class="botonPrincipal" id="crearConfirmar"><%- lang('inicio.crear') %></button>
            </div>
        </form>
    </div>

    <!-- Tooltip compartido de gemas y cabezas (reino.js). -->
    <div id="reinoTooltip"></div>
    <script src="./assets/js/scripts/landing.js"></script>
    <script src="./assets/js/scripts/reino.js"></script>
    <script src="./assets/js/scripts/inicio.js"></script>
</div>
