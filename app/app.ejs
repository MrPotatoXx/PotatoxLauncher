<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/reino.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/potato.css">
</head>
<body>
    <!-- Anuncio de la Luna de Sangre (reino.js); solo se ve en la vista de Tierras Malditas. -->
    <div id="lunaAnuncio"><%- lang('app.lunaAnuncio') %></div>
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div class="cargaMarca">
            <svg class="cargaEmblema" viewBox="0 0 400 480" aria-hidden="true">
                <path d="M205 30 C 290 30 345 95 352 180 C 356 225 368 250 368 300 C 370 400 300 458 205 458 C 105 458 32 405 34 318 C 36 250 52 205 58 170 C 72 85 125 30 205 30 Z" fill="#F3F1E7" stroke="#2C312A" stroke-width="16" stroke-linejoin="round"/>
                <path d="M30 170 L368 150 L372 182 L34 200 Z" fill="#111" stroke="#111" stroke-width="10" stroke-linejoin="round"/>
                <path d="M62 180 L192 174 C 190 232 162 262 122 260 C 86 258 66 226 62 180 Z" fill="#111"/>
                <path d="M210 172 L352 166 C 350 226 318 258 274 256 C 232 254 212 226 210 172 Z" fill="#111"/>
                <path d="M150 312 C 200 312 245 300 272 280 C 270 316 244 340 214 338 C 190 336 174 326 166 313 Z" fill="#111"/>
            </svg>
            <div class="cargaTexto">
                <span class="cargaNombre"><%- lang('inicio.marcaNombre') %></span>
                <span class="cargaLauncher"><%- lang('inicio.marcaLauncher') %></span>
            </div>
        </div>
        <div class="cargaPie">
            <img id="loadSpinnerImage" class="cargaMascota rotating" src="assets/images/potato/mascota-cargando.png" alt="">
            <span class="cargaEstado"><%- lang('inicio.cargandoTexto') %></span>
        </div>
    </div>
    <!-- Actualización obligatoria (actualizacion.js): tapa todo menos la barra de la ventana. -->
    <div id="bloqueoActualizacion" hidden>
        <div class="bloqueoCaja" role="alertdialog" aria-labelledby="bloqueoTitulo">
            <img class="bloqueoMascota" src="assets/images/potato/mascota-cargando.png" alt="">
            <h2 id="bloqueoTitulo" class="tituloPixel"><%- lang('inicio.actObligatoriaTitulo') %></h2>
            <p id="bloqueoVersion" class="textoSuave"></p>
            <div id="bloqueoNotas" class="bloqueoNotas" hidden></div>
            <div id="bloqueoBarra" class="lanzamientoBarra">
                <progress id="bloqueoProgreso" value="0" max="100"></progress>
                <span id="bloqueoPorcentaje">0%</span>
            </div>
            <p id="bloqueoEstado" class="textoSuave"></p>
            <div id="bloqueoError" class="filaBotones" hidden>
                <button id="bloqueoReintentar" class="botonPrincipal"><%- lang('inicio.actReintentar') %></button>
                <a id="bloqueoDescargar" class="botonSecundario" href="https://mc.potatox.me/descargar"><%- lang('inicio.actDescargarMano') %></a>
            </div>
        </div>
    </div>
    <!-- Actualización opcional lista (una vez por versión). -->
    <div id="toastActualizacion" role="status" hidden>
        <span id="toastActualizacionTexto"></span>
        <button class="botonPrincipal" data-accion="reiniciar"><%- lang('inicio.actReiniciar') %></button>
        <button class="botonIcono cerrarToast" data-accion="cerrar" aria-label="<%- lang('inicio.actCerrar') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <script src="./assets/js/scripts/ambiente.js"></script>
    <script src="./assets/js/scripts/actualizacion.js"></script>
</body>
</html>